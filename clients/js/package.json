{
  "name": "robowright",
  "version": "0.1.0",
  "description": "Playwright-style testing for robot software, from JavaScript and TypeScript: simulated robots, matchers and traces, driven through the robowright MCP server.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./src/index.js"
    },
    "./test": {
      "types": "./test.d.ts",
      "default": "./src/test.js"
    }
  },
  "files": ["src", "index.d.ts", "test.d.ts", "README.md"],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/client.test.js test/runner.test.js"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JeremiahM37/robowright.git",
    "directory": "clients/js"
  },
  "keywords": ["robotics", "testing", "simulation", "mujoco", "ros2", "playwright", "mcp"]
}
